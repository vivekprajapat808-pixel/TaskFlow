<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta title="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Oops!</h1>
    <div class="form-card" style="border-left: 5px solid #dc3545; text-align: center;">
        <h3 style="color: #dc3545;">An error occurred</h3>
        <p><%= message %></p>
        <a href="/tasks" class="btn btn-primary" style="margin-top: 20px;">Return to Dashboard</a>
    </div>
</body>
</html>