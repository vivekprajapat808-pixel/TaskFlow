<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta title="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Detail</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Task Details</h1>

    <div class="detail-card"> 
        <p><strong>ID:</strong> <span class="id-badge"><%= task.id %></span></p>
        <h3 class="title">Task title: <%= task.title %></h3>
        <p class="details"><strong>Details:</strong> <%= task.details %></p>
        
        <hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;">
        
        <div class="actions">
            <a href="/tasks/<%= task.id %>/edit" class="btn btn-primary">Edit This Task</a>
            <a href="/tasks" class="back-link">← Back to Dashboard</a>
        </div>
    </div>
</body>
</html>