<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta title="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Task</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Add a New Task</h1>

    <div class="form-card">
        <form method="post" action="/tasks">
            <div class="input-group">
                <label for="title">Task title</label>
                <input type="text" id="title" placeholder="Enter your title" name="title" required />
            </div>

            <div class="input-group">
                <label for="details">Task Details</label>
                <textarea id="details" placeholder="What needs to be done?" name="details" rows="4" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Add Task</button>
        </form>

        <a href="/tasks" class="back-link">← Cancel and Go Back</a>
    </div>
</body>
</html>